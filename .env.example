# ==============================================================================
# SMARTTRIP ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to `.env` for local development:
#   cp .env.example .env
#
# HARD RULES:
# - NEVER commit real secrets to git. The `.env` file is gitignored.
# - NEVER prefix server secrets with `VITE_` or `NEXT_PUBLIC_`.
# - All features function on 100% FREE services. No credit cards required.
# ==============================================================================

# ==============================================================================
# 1. PUBLIC / CLIENT VARIABLES (Exposed to the browser bundle)
# ==============================================================================

# Canonical URL of the application
# - Purpose: Base URL for canonical tags, OpenGraph sharing cards, sitemap URLs, and auth redirects
# - Status: OPTIONAL in local dev; RECOMMENDED in production
# - Free Source: Free Vercel subdomain (https://your-app.vercel.app) or localhost
# - Fallback: Defaults to http://localhost:3000 in dev or window.location.origin in browser
VITE_SITE_URL=http://localhost:3000

# Supabase Project HTTPS API URL
# - Purpose: Endpoints for Supabase client-side authentication and database queries
# - Status: OPTIONAL for guest mode; REQUIRED for cloud user accounts and cloud persistence
# - Free Source: Free tier at https://supabase.com (Project Settings -> API -> Project URL)
# - Fallback: App operates in offline guest mode using browser localStorage and mock seed data
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anonymous Public API Key
# - Purpose: Public client key safe for browser exposure (protected by Row Level Security)
# - Status: OPTIONAL for guest mode; REQUIRED for cloud user accounts and cloud persistence
# - Free Source: Free tier at https://supabase.com (Project Settings -> API -> Project API Keys -> anon public)
# - Fallback: App operates in offline guest mode using browser localStorage and mock seed data
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder

# Optional Sentry DSN for frontend error monitoring (100% free tier at https://sentry.io)
# - Status: OPTIONAL. If omitted, frontend errors log to console and local telemetry
# VITE_SENTRY_DSN=

# ==============================================================================
# 2. SERVER-ONLY VARIABLES (Accessible ONLY on server - NEVER exposed to browser)
# ==============================================================================

# Server-Side Supabase URL (falls back to VITE_SUPABASE_URL if unset)
# - Purpose: Database connections initiated from server functions
# - Status: OPTIONAL (defaults to VITE_SUPABASE_URL)
SUPABASE_URL=https://your-project-ref.supabase.co

# Server-Side Supabase Anon Key (falls back to VITE_SUPABASE_ANON_KEY if unset)
# - Purpose: Read-only and RLS-scoped database operations from server functions
# - Status: OPTIONAL (defaults to VITE_SUPABASE_ANON_KEY)
SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder

# Supabase Service Role Key (BYPASSES Row Level Security - KEEP STRICTLY SECRET)
# - Purpose: Administrative background operations, error log pruning, and keep-alive pings
# - Status: OPTIONAL. Never required for standard user features
# - Free Source: Free tier at https://supabase.com (Project Settings -> API -> service_role secret)
# - Fallback: Administrative cleanup routines are skipped; standard user features use anon client
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder

# Google Gemini API Key
# - Purpose: Powers AI travel itinerary generation with Google Gemini 2.5 Flash
# - Status: OPTIONAL (Recommended). Generates dynamic AI travel plans
# - Free Source: Free at https://aistudio.google.com/app/apikey (15 RPM / 1,500 RPD free, no card required)
# - Fallback: If missing, rate-limited, or unreachable, server seamlessly falls back to the
#             built-in heuristic rule-based itinerary engine (`buildPlan()`) with 0 user errors
GEMINI_API_KEY=your-gemini-api-key-placeholder

# Demo Payment HMAC Signing Secret
# - Purpose: Server-side cryptographic signing for demo booking vouchers and payment tickets
# - Status: OPTIONAL. Protects demo payment tampering with HMAC-SHA256
# - Free Source: Generate any 32+ character string (e.g., `openssl rand -hex 32` or random phrase)
# - Fallback: Defaults to internal development fallback secret
DEMO_PAY_SECRET=your-32-character-random-demo-pay-secret-placeholder

# Cron Job Authorization Secret
# - Purpose: Secures the /api/cron/price-fluctuations endpoint triggered by GitHub Actions
# - Status: OPTIONAL in local development; REQUIRED for automated GitHub Actions price alert cron
# - Free Source: Generate any 32+ character string (e.g., `openssl rand -hex 32`)
# - Fallback: Defaults to "dev-cron-secret" in non-production environments
CRON_SECRET=your-32-character-random-cron-secret-placeholder

# Optional Razorpay Test Mode Credentials
# - Purpose: Optional testing with Razorpay's test mode payment gateway
# - Status: OPTIONAL. SmartTrip uses the built-in free DemoPayProvider by default
# - Free Source: Free test mode at https://dashboard.razorpay.com (Settings -> API Keys)
# - Fallback: Uses the built-in DemoPayProvider with realistic simulated cards and UPI
# RAZORPAY_KEY_ID=rzp_test_yourKeyIdPlaceholder
# RAZORPAY_KEY_SECRET=your-razorpay-test-secret-placeholder

# ==============================================================================
# 3. CI / DEPLOYMENT CONFIGURATION (Vercel, Netlify, GitHub Actions)
# ==============================================================================

# Nitro Deployment Preset
# - Purpose: Directs Nitro/Vinxi SSR engine to target specific serverless runtimes
# - Status: OPTIONAL. Auto-detected on Vercel (`VERCEL=1`) and Netlify (`NETLIFY=true`)
# - Options: vercel | netlify | node-server (default)
NITRO_PRESET=vercel
