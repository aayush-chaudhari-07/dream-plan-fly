# Site Configuration
VITE_SITE_URL=https://your-domain.com

# Supabase Backend (Postgres + Auth)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# AI Integration (Server-side Google Gemini Flash API - never exposed to client)
GEMINI_API_KEY=

# Error Monitoring (Optional / Future)
# VITE_SENTRY_DSN=

# Payment Gateway (Demo Gateway runs free with built-in HMAC; Razorpay test is optional)
DEMO_PAY_SECRET=
# RAZORPAY_KEY_ID=rzp_test_xxxx
# RAZORPAY_KEY_SECRET=

# Scheduled Jobs Secret (Protects /api/cron/price-fluctuations called by GitHub Actions)
CRON_SECRET=

# Deployment Nitro Preset (e.g., vercel, netlify, node-server - auto-detected on Vercel/Netlify)
NITRO_PRESET=vercel

# Optional Supabase Service Role Key (for administrative scripts/seed only; NEVER expose to client)
# SUPABASE_SERVICE_ROLE_KEY=
